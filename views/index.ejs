<!DOCTYPE html>
<html>
<head>
  <title>OCPI JSON Validator</title>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="description" content="Validate OCPI 2.2.1 JSON messages instantly using this Node.js web app. Built with Express, EJS & AJV for accurate and fast schema validation." />
  <meta name="keywords" content="OCPI JSON validator, OCPI 2.2.1, AJV, JSON schema validation, EV Roaming JSON validator" />
  <meta name="robots" content="index, follow">
  <meta name="author" content="Maanasa" />

  <!-- Canonical (update dynamically for pages if needed) -->
  <link rel="canonical" href="https://ocpi-json-schema-validator.vercel.app/" />

  <!-- Open Graph (Facebook, LinkedIn) -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content="OCPI JSON Schema Validator | Validate OCPI 2.2.1 Messages" />
  <meta property="og:description" content="Validate OCPI 2.2.1 JSON messages instantly using this Node.js web app." />
  <meta property="og:url" content="https://ocpi-json-schema-validator.vercel.app/" />
  <meta property="og:image" content="https://ocpi-json-schema-validator.vercel.app/og-image.jpg" />

  <!-- Twitter card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="OCPI JSON Schema Validator" />
  <meta name="twitter:description" content="Validate OCPI 2.2.1 JSON messages instantly." />
  <meta name="twitter:image" content="https://ocpi-json-schema-validator.vercel.app/og-image.jpg" />

  <link rel="stylesheet" href="/styles.css">
  <script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "OCPI JSON Schema Validator",
  "url": "https://ocpi-json-schema-validator.vercel.app/",
  "description": "Validate OCPI 2.2.1 JSON messages instantly using AJV and official schema definitions.",
  "applicationCategory": "DeveloperTool",
  "operatingSystem": "Web",
  "author": {
    "@type": "Person",
    "name": "Maanasa"
  },
  "sameAs": [
    "https://github.com/maanasarao01/ocpi-json-schema-validator"
  ],
  "image": "https://ocpi-json-schema-validator.vercel.app/og-image.png"
}
</script>

</head>
<body>
  <div class="container">
    <h1>🔍 OCPI JSON Validator</h1>

    <form action="/validate" method="POST">
      <label for="schema">Select Schema:</label>
      <select name="schema" id="schema" required>
        <% schemas.forEach(schema => { %>
          <option value="<%= schema %>"><%= schema %></option>
        <% }); %>
      </select>

      <label for="jsonInput">Paste JSON:</label>
      <textarea name="jsonInput" id="jsonInput" rows="15" placeholder="Paste your JSON here..." required></textarea>

      <button type="submit">Validate</button>
    </form>

 <% if (result) { %>
  <div class="result <%= result.valid ? 'success' : 'error' %>">
    <% if (result.valid) { %>
      ✅ JSON is good to go!
    <% } else { %>
      ❌ Validation failed:
      <ul>
        <% result.errors.forEach(err => { %>
          <% if (err.keyword === 'required') { %>
            <li>
              🚫 Missing required parameters:
              <strong><%= Array.isArray(err.params.missingProperty) 
                ? err.params.missingProperty.join(', ') 
                : (err.params.missingProperty || (err.params.required || []).join(', ')) %></strong>
            </li>
          <% } else if (err.keyword === 'additionalProperties') { %>
            <li>
              ⚠️ Parameters additional to the OCPI spec are not allowed:
              <strong>
                <%= err.params.additionalProperty 
                  ? err.params.additionalProperty 
                  : (Array.isArray(err.params.additionalProperties)
                      ? err.params.additionalProperties.join(', ')
                      : '') %>
              </strong>
            </li>
          <% } else { %>
            <li>
              📍 <%= err.schemaPath %>: <%= err.message %>
            </li>
          <% } %>
        <% }); %>
      </ul>
    <% } %>
  </div>
<% } %>
  </div>
</body>
</html>
